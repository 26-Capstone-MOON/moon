<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="128dp"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical">

    <!-- Left: icon box -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_icon_box">

        <ImageView
            android:id="@+id/widget_arrow_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_arrow_right"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- Right: content column -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="다음 안내"
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary" />

        <TextView
            android:id="@+id/widget_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="조앤조의원 앞에서 우회전하세요"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Divider -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="8dp"
            android:background="@color/widget_divider"
            android:contentDescription="@null" />

        <!-- Next info row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_arrow_right_small"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="다음 · KB국민은행"
                android:textSize="12sp"
                android:textColor="@color/widget_text_secondary" />
        </LinearLayout>

        <!-- Progress row: segments + percentage -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <!-- Progress bar: 11 segments -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:weightSum="11"
                android:baselineAligned="false">

                <ImageView
                    android:id="@+id/widget_progress_seg_0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_progress_filled"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@+id/widget_progress_seg_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_progress_filled"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@+id/widget_progress_seg_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_progress_filled"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@+id/widget_progress_seg_3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_progress_filled"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@+id/widget_progress_seg_4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_progress_empty"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@+id/widget_progress_seg_5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_progress_empty"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@+id/widget_progress_seg_6"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_progress_empty"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@+id/widget_progress_seg_7"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_progress_empty"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@+id/widget_progress_seg_8"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_progress_empty"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@+id/widget_progress_seg_9"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_progress_empty"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@+id/widget_progress_seg_10"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_progress_empty"
                    android:contentDescription="@null" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="36%"
                android:textSize="12sp"
                android:textColor="@color/widget_text_secondary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
